<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher background: white paper the mark sits on.

    Deliberately almost nothing. The previous background was a synthwave grid, which competed with
    the head in front of it and dated the whole icon; white lets the one dark shape in the drawer be
    the thing that is recognised. It is not flat white, though — a flat fill reads as a missing asset
    next to the shaded icons Android ships. The shading is kept under ten percent everywhere: a
    diagonal fall from white to a cool off-white, a vignette that only touches the corners, and a
    soft patch under the mark so it looks set down rather than pasted on.

    Only the centre 72x72 of this 108x108 canvas is guaranteed to survive the launcher's mask, and
    the corners are guaranteed *not* to. Nothing here carries meaning, so any mask is safe.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper: white at the top left, a cool off-white by the bottom right. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="0"
                android:endX="94"
                android:endY="108">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFFAFBFB" />
                <item android:offset="1" android:color="#FFF0F3F2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vignette. Nothing at all across the middle, a breath of grey where the edges turn. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="74">
                <item android:offset="0" android:color="#0027312D" />
                <item android:offset="0.62" android:color="#0027312D" />
                <item android:offset="1" android:color="#1427312D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Contact shadow: the mark's own weight on the paper, low and wide under it. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="72"
                android:gradientRadius="34">
                <item android:offset="0" android:color="#16222B27" />
                <item android:offset="0.5" android:color="#0B222B27" />
                <item android:offset="1" android:color="#00222B27" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
